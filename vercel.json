{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "cloud-gateway": {
      "root": "cloud-gateway",
      "framework": "fastapi",
      "entrypoint": "app.py"
    }
  },
  "rewrites": [
    {
      "source": "/gateway/(.*)",
      "destination": {
        "service": "cloud-gateway"
      }
    },
    {
      "source": "/node/:path*",
      "destination": "http://35.172.220.194:8001/:path*"
    },
    {
      "source": "/thumbnails/:path*",
      "destination": "http://35.172.220.194:8001/thumbnails/:path*"
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}

