# Ex-Vero — environment template.
#
# Copy me to `.env` and edit. docs/deployment.md walks through every step.
#
#   cp env.example .env
#   docker compose --env-file .env -f docker/docker-compose.yml up --build
#
# Every value below has a working default for a single-host Docker run, so the
# stack starts with no edits at all. Change a value only when you need to.

# --- Edge nodes -------------------------------------------------------------
# Where edge nodes push deltas. On the compose network this is the gateway
# service name; point it at a real host to sync to a remote hub.
EDGE_HUB_URL=http://gateway:8088

# Which vertical config the tiny node loads. `tiny-edge.yaml` is the 1 CPU /
# 512 MB text-only profile. The larger nodes load the full text + image config.
EDGE_CONFIG_PATH=/app/config/tiny-edge.yaml

# Browser origins allowed to call a node's API, comma-separated. Add your
# dashboard's public URL here when it is served from a different origin.
# ALLOWED_ORIGINS=https://my-dashboard.example

# Point at a remote Ollama when it is not the compose `ollama` service.
# OLLAMA_ENDPOINT=http://ollama:11434

# --- Cloud gateway / Qdrant hub ---------------------------------------------
# The hub the gateway writes to. Defaults to the compose `qdrant` service.
QDRANT_URL=http://qdrant:6333

# Set only for a managed/cloud Qdrant that requires an API key.
# QDRANT_API_KEY=

# Per-device shared secrets that enable gateway auth. Leave empty to run the
# demo gateway with auth disabled.
# GATEWAY_DEVICE_SECRETS=

# Admin token for privileged gateway routes.
# GATEWAY_ADMIN_TOKEN=
